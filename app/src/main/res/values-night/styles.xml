<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 夜间模式：内容区仍由系统强制深色（MIUI/ColorOS）或 DayNight 兜底，
         但状态栏/导航栏不再跟着反转——这里显式给深色底 + 浅色图标，
         在"无强制反转"的 ROM（如 ColorOS）上也是正确的。 -->
    <style name="Theme.PhoneStick" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/md_theme_surface_dark</item>
        <item name="android:navigationBarColor">@color/md_theme_surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
